# Written by maisys from your config repo. The next sync backs up and
# replaces any changes made here.
#
# Your fish settings and the environment of the modules your config
# enables. fish loads it by itself, before config.fish.

# shell.fish.variables
set -gx EDITOR "nvim"
set -gx HIST_STAMPS "yyyy-mm-dd"

# shell.fish.pre_snippets
source "$HOME/.config/maisys/shell/fish/first.fish"

# Variables
set -gx GOPATH "$HOME/go"
set -gx GREETING "say \"hi\" to $GOPATH""s, it costs \$5 \\ `id`"

# Folders at the front of PATH, unless PATH has them already
begin
    set -l __maisys_path
    for __maisys_dir in "$HOME/.local/bin" "$GOPATH/bin"
        if not contains -- $__maisys_dir $__maisys_path $PATH
            set -a __maisys_path $__maisys_dir
        end
    end
    set -gx PATH $__maisys_path $PATH
end

# direnv
direnv hook fish | source

# atuin
atuin init fish | source

# sdkman has no fish integration, so it's left out

# shell.fish.snippets
source "$HOME/.config/maisys/shell/fish/aliases.fish"
source "$HOME/.config/maisys/shell/fish/more aliases.fish"
