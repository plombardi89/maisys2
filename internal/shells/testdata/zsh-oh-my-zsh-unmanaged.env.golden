# Written by maisys from your config repo. The next sync backs up and
# replaces any changes made here.
#
# Your zsh settings and the environment of the modules your config
# enables. Load it from your ~/.zshrc with:
#
#   source ~/.config/maisys/shell/env.zsh

# shell.zsh.variables
export EDITOR="nvim"
export HIST_STAMPS="yyyy-mm-dd"

# shell.zsh.pre_snippets
source "${HOME}/.config/maisys/shell/zsh/first.zsh"

# oh-my-zsh (shell.zsh.oh_my_zsh), with its own updater turned off
export ZSH="${HOME}/.oh-my-zsh"
ZSH_CUSTOM="${ZSH}/custom"
ZSH_THEME="aphrodite"
plugins=(git zsh-autosuggestions)
DISABLE_AUTO_UPDATE=true
zstyle ':omz:update' mode disabled
source "${ZSH}/oh-my-zsh.sh"

# Variables
export GOPATH="${HOME}/go"
export GREETING="say \"hi\" to ${GOPATH}s, it costs \$5 \\ \`id\`"

# Folders at the front of PATH, unless PATH has them already
__maisys_path=
for __maisys_dir in "${HOME}/.local/bin" "${GOPATH}/bin"; do
	case ":${__maisys_path}:${PATH}:" in
	*":${__maisys_dir}:"*) ;;
	*) __maisys_path="${__maisys_path:+${__maisys_path}:}${__maisys_dir}" ;;
	esac
done
if [ -n "${__maisys_path}" ]; then
	PATH="${__maisys_path}${PATH:+:${PATH}}"
fi
export PATH
unset __maisys_dir __maisys_path

# direnv
eval "$(direnv hook zsh)"

# atuin
eval "$(atuin init zsh)"

# sdkman
export SDKMAN_DIR="$HOME/.sdkman"
[ -s "$SDKMAN_DIR/bin/sdkman-init.sh" ] && source "$SDKMAN_DIR/bin/sdkman-init.sh"

# shell.zsh.snippets
source "${HOME}/.config/maisys/shell/zsh/aliases.zsh"
source "${HOME}/.config/maisys/shell/zsh/more aliases.zsh"
